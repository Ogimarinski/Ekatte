{
  "type": "object",
  "properties": {
    "country_code": { "type": "string", "enum": ["BG", "CN"] },
    "granularity": { "type": "string", "enum": ["year", "month"] },
    "temp_type": { "type": "string", "enum": ["max", "min", "avg"] },
    "from_year": { "type": "integer", "minimum": 1950, "maximum": 2100 },
    "to_year": { "type": "integer", "minimum": 1950, "maximum": 2100 },
    "from_month": { "type": "integer", "minimum": 1, "maximum": 12 },
    "to_month": { "type": "integer", "minimum": 1, "maximum": 12 }
  },
  "required": [
    "country_code",
    "granularity",
    "temp_type",
    "from_year",
    "to_year"
  ],
  "additionalProperties": false,

  "if": {
    "properties": {
      "granularity": {
        "const": "month"
      }
    }
  },
  "then": {
    "required": ["from_month", "to_month"]
  }
}
