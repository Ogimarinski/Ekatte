{
  "type": "object",
  "properties": {
    "id": { "type": "integer", "minimum": 1 },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "\\S"
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    }
  },
  "required": ["id"],
  "additionalProperties": false,

  "anyOf": [{ "required": ["name"] }, { "required": ["code"] }]
}
