{
  "type": "object",

  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "\\S"
    },
    "municipality_id": {
      "type": "integer",
      "minimum": 1
    },
    "mayorality_id": {
      "type": ["integer", "null"],
      "minimum": 1
    }
  },

  "required": ["id"],

  "additionalProperties": false,

  "anyOf": [
    { "required": ["name"] },
    { "required": ["municipality_id"] },
    { "required": ["mayorality_id"] }
  ]
}
